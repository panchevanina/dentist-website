{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex usage activity and feedback metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "record_id",
    "observed_at",
    "project_id",
    "session_id",
    "turn_id",
    "source",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "query",
        "tool",
        "turn",
        "assessment",
        "diagnostic"
      ]
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "event_type",
        "source_ref",
        "line_number",
        "timestamp",
        "client_version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "codex_session_log",
            "codex_app_server",
            "openai_api",
            "manual",
            "synthetic"
          ]
        },
        "event_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "client_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "query"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "character_count",
              "image_count",
              "ordinal_in_turn",
              "attribution"
            ],
            "properties": {
              "character_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "image_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "ordinal_in_turn": {
                "type": "integer",
                "minimum": 1
              },
              "attribution": {
                "enum": [
                  "turn",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "started_at",
              "completed_at",
              "duration_ms",
              "output_bytes",
              "exit_code",
              "success"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "in_progress",
                  "completed",
                  "failed",
                  "unknown"
                ]
              },
              "started_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "success": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "turn"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "started_at",
              "completed_at",
              "duration_ms"
            ],
            "properties": {
              "status": {
                "enum": [
                  "in_progress",
                  "completed",
                  "failed",
                  "interrupted"
                ]
              },
              "started_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "completed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "assessment"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_type",
              "outcome",
              "check_status",
              "rating",
              "redacted_summary",
              "tags"
            ],
            "properties": {
              "task_type": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "success",
                  "failed",
                  "blocked",
                  "unknown"
                ]
              },
              "check_status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "unknown"
                ]
              },
              "rating": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "redacted_summary": {
                "type": "string",
                "maxLength": 240
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "diagnostic"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
